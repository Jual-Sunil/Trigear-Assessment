# Application
APP_NAME="AI Email Intelligence Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# API
ALLOWED_ORIGINS=["http://localhost:5173"]

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/email_intelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Token Encryption — must be at least 32 chars
TOKEN_ENCRYPTION_KEY=aBiEjXVwwWEJuUzpB2doVr76Ch5rgfpb

# HuggingFace / AI
HUGGINGFACE_CACHE_DIR=/tmp/hf_cache
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CLASSIFICATION_MODEL_NAME=facebook/bart-large-mnli
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
EMBEDDING_DIMENSION=384

# LLM Provider (openai | claude | gemini)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Gmail Sync
GMAIL_SYNC_MAX_RESULTS=500
GMAIL_SYNC_BATCH_SIZE=50
